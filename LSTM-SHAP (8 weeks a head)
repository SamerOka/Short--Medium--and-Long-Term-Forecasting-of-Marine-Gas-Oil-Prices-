# ============================================================
# WALK-FORWARD / ROLLING-ORIGIN LSTM FORECASTING
# 8-WEEK-AHEAD DIRECT MULTI-STEP FORECAST
# ============================================================

import numpy as np
import pandas as pd
import shap
import tensorflow as tf

from tensorflow.keras.models import Sequential
from tensorflow.keras.layers import LSTM, Dense, Dropout
from tensorflow.keras.callbacks import EarlyStopping

from sklearn.preprocessing import MinMaxScaler
from sklearn.metrics import mean_absolute_error, mean_squared_error

from lightgbm import LGBMRegressor

import warnings
warnings.filterwarnings("ignore")


# ============================================================
# 1. LOAD DATA
# ============================================================

file_path = "MGO Forecasting MARCH.csv"

data = pd.read_csv(file_path)

data.columns = data.columns.str.strip()

# Change if your date column has a different name
date_col = "Date"

data[date_col] = pd.to_datetime(data[date_col])

data = data.sort_values(date_col).reset_index(drop=True)


# ============================================================
# 2. DEFINE TARGET AND FEATURES
# ============================================================

target_col = data.columns[-1]

feature_cols = [
    col for col in data.columns
    if col not in [date_col, target_col]
]

for col in feature_cols + [target_col]:
    data[col] = pd.to_numeric(data[col], errors="coerce")

# Remove observations where target is missing
data = data.dropna(
    subset=[target_col]
).reset_index(drop=True)


# ============================================================
# 3. TRAIN / VALIDATION / TEST SPLIT
# ============================================================

n = len(data)

train_end = int(n * 0.70)
validation_end = int(n * 0.80)

train_data = data.iloc[:train_end].copy()

validation_data = data.iloc[
    train_end:validation_end
].copy()

test_data = data.iloc[
    validation_end:
].copy()

print("Total observations:", n)
print("Training observations:", len(train_data))
print("Validation observations:", len(validation_data))
print("Test observations:", len(test_data))


# ============================================================
# 4. INITIAL DEVELOPMENT DATA
# ============================================================

development_data = pd.concat(
    [
        train_data,
        validation_data
    ],
    axis=0
).reset_index(drop=True)


# ============================================================
# 5. MODEL PARAMETERS
# ============================================================

SEQ_LEN = 24

# IMPORTANT:
# 8-week-ahead forecasting
HORIZON = 8

# Move forecast origin forward by one week
STEP = 1

EPOCHS = 50
BATCH_SIZE = 32


# ============================================================
# 6. CREATE MULTI-STEP SEQUENCES
# ============================================================

def create_sequences(
    X_data,
    y_data,
    seq_len=24,
    horizon=8
):

    X = []
    y = []

    for i in range(
        seq_len,
        len(X_data) - horizon + 1
    ):

        X.append(
            X_data[i-seq_len:i]
        )

        y.append(
            y_data[i:i+horizon]
        )

    return np.array(X), np.array(y)


# ============================================================
# 7. WALK-FORWARD FORECASTING
# ============================================================

forecast_records = []

history = development_data.copy()

test_start_index = 0

while test_start_index < len(test_data):

    print(
        "\n======================================"
    )

    print(
        f"Forecast origin "
        f"{test_start_index + 1} "
        f"of {len(test_data)}"
    )

    origin_date = test_data.iloc[
        test_start_index
    ][date_col]

    print(
        "Forecast origin:",
        origin_date
    )


    # ========================================================
    # 8. HISTORICAL INFORMATION AVAILABLE AT THIS ORIGIN
    # ========================================================

    historical = history.copy()


    # ========================================================
    # 9. HANDLE MISSING VALUES
    #    USING ONLY AVAILABLE HISTORY
    # ========================================================

    historical[feature_cols] = (
        historical[feature_cols]
        .interpolate(method="linear")
        .bfill()
        .ffill()
    )

    historical[target_col] = (
        historical[target_col]
        .interpolate(method="linear")
        .bfill()
        .ffill()
    )


    # ========================================================
    # 10. SHAP FEATURE SELECTION
    #
    # ONLY DATA AVAILABLE AT CURRENT ORIGIN
    # ========================================================

    X_hist = historical[
        feature_cols
    ]

    y_hist = historical[
        target_col
    ]


    lgb_model = LGBMRegressor(
        n_estimators=300,
        learning_rate=0.03,
        max_depth=6,
        random_state=42,
        verbosity=-1
    )

    lgb_model.fit(
        X_hist,
        y_hist
    )


    explainer = shap.TreeExplainer(
        lgb_model
    )

    shap_values = explainer.shap_values(
        X_hist
    )


    shap_importance = pd.DataFrame({

        "Feature": feature_cols,

        "Importance":
            np.mean(
                np.abs(shap_values),
                axis=0
            )
    })


    shap_importance = (
        shap_importance
        .sort_values(
            "Importance",
            ascending=False
        )
        .reset_index(drop=True)
    )


    # Select top 5 SHAP features
    selected_features = (
        shap_importance
        .head(5)["Feature"]
        .tolist()
    )


    print(
        "Selected features:",
        selected_features
    )


    # ========================================================
    # 11. SCALE USING ONLY HISTORICAL DATA
    # ========================================================

    X_scaler = MinMaxScaler()

    y_scaler = MinMaxScaler()


    X_hist_raw = historical[
        selected_features
    ].values

    y_hist_raw = historical[
        [target_col]
    ].values


    X_hist_scaled = X_scaler.fit_transform(
        X_hist_raw
    )

    y_hist_scaled = y_scaler.fit_transform(
        y_hist_raw
    ).flatten()


    # ========================================================
    # 12. CREATE TRAINING SEQUENCES
    # ========================================================

    X_train_seq, y_train_seq = (
        create_sequences(
            X_hist_scaled,
            y_hist_scaled,
            seq_len=SEQ_LEN,
            horizon=HORIZON
        )
    )


    print(
        "Training sequence shape:",
        X_train_seq.shape
    )

    print(
        "Target sequence shape:",
        y_train_seq.shape
    )


    # ========================================================
    # 13. BUILD LSTM
    # ========================================================

    tf.keras.backend.clear_session()


    model = Sequential([

        LSTM(
            64,
            return_sequences=True,
            input_shape=(
                SEQ_LEN,
                len(selected_features)
            )
        ),

        Dropout(0.2),

        LSTM(32),

        Dropout(0.2),

        # IMPORTANT:
        # Eight outputs = eight weeks ahead
        Dense(HORIZON)
    ])


    model.compile(
        optimizer="adam",
        loss="mse"
    )


    # ========================================================
    # 14. MODEL TRAINING
    # ========================================================

    early_stop = EarlyStopping(
        monitor="val_loss",
        patience=8,
        restore_best_weights=True
    )


    model.fit(

        X_train_seq,

        y_train_seq,

        epochs=EPOCHS,

        batch_size=BATCH_SIZE,

        validation_split=0.10,

        callbacks=[early_stop],

        verbose=0,

        shuffle=False
    )


    # ========================================================
    # 15. LAST 24 WEEKS AVAILABLE AT CURRENT ORIGIN
    # ========================================================

    last_history = historical.tail(
        SEQ_LEN
    )


    X_last = last_history[
        selected_features
    ].values


    X_last_scaled = X_scaler.transform(
        X_last
    )


    X_last_scaled = X_last_scaled.reshape(
        1,
        SEQ_LEN,
        len(selected_features)
    )


    # ========================================================
    # 16. GENERATE 8-WEEK-AHEAD FORECAST
    # ========================================================

    forecast_scaled = model.predict(
        X_last_scaled,
        verbose=0
    )


    # Shape = (1, 8)
    forecast_scaled = (
        forecast_scaled.reshape(-1, 1)
    )


    forecast = y_scaler.inverse_transform(
        forecast_scaled
    ).flatten()


    # ========================================================
    # 17. ACTUAL VALUES FOR THE 8-WEEK HORIZON
    # ========================================================

    actuals = test_data.iloc[
        test_start_index:
        test_start_index + HORIZON
    ][target_col].values


    forecast_dates = test_data.iloc[
        test_start_index:
        test_start_index + HORIZON
    ][date_col].values


    # At the end of the test period, fewer than 8
    # observations may remain.
    forecast = forecast[
        :len(actuals)
    ]


    # ========================================================
    # 18. SAVE FORECASTS
    # ========================================================

    for h in range(
        len(actuals)
    ):

        forecast_records.append({

            "Forecast_Origin":
                origin_date,

            "Forecast_Date":
                forecast_dates[h],

            "Horizon_Week":
                h + 1,

            "Actual":
                actuals[h],

            "Forecast":
                forecast[h]
        })


    # ========================================================
    # 19. WALK FORWARD ONE WEEK
    #
    # The newly observed actual value becomes available.
    # The model will be RE-ESTIMATED at the next origin.
    # ========================================================

    history = pd.concat(
        [
            history,

            test_data.iloc[
                test_start_index:
                test_start_index + STEP
            ]
        ],
        ignore_index=True
    )


    test_start_index += STEP


# ============================================================
# 20. RESULTS
# ============================================================

results = pd.DataFrame(
    forecast_records
)


print(
    "\nForecasting completed."
)

print(
    results.head(20)
)


# ============================================================
# 21. HORIZON-SPECIFIC ACCURACY
# ============================================================

metrics = []


for h in range(
    1,
    HORIZON + 1
):

    h_data = results[
        results["Horizon_Week"] == h
    ]


    if len(h_data) == 0:
        continue


    actual = h_data[
        "Actual"
    ].values

    predicted = h_data[
        "Forecast"
    ].values


    mae = mean_absolute_error(
        actual,
        predicted
    )


    rmse = np.sqrt(
        mean_squared_error(
            actual,
            predicted
        )
    )


    nonzero = actual != 0


    if np.any(nonzero):

        mape = np.mean(
            np.abs(
                (
                    actual[nonzero]
                    -
                    predicted[nonzero]
                )
                /
                actual[nonzero]
            )
        ) * 100

    else:

        mape = np.nan


    metrics.append({

        "Horizon_Week": h,

        "MAE": mae,

        "RMSE": rmse,

        "MAPE": mape,

        "N_Forecasts":
            len(h_data)
    })


metrics_df = pd.DataFrame(
    metrics
)


print(
    "\nAccuracy by forecast horizon:"
)

print(
    metrics_df
)


# ============================================================
# 22. OVERALL ACCURACY
# ============================================================

overall_actual = results[
    "Actual"
].values

overall_forecast = results[
    "Forecast"
].values


overall_mae = mean_absolute_error(
    overall_actual,
    overall_forecast
)


overall_rmse = np.sqrt(
    mean_squared_error(
        overall_actual,
        overall_forecast
    )
)


nonzero = overall_actual != 0

overall_mape = np.mean(
    np.abs(
        (
            overall_actual[nonzero]
            -
            overall_forecast[nonzero]
        )
        /
        overall_actual[nonzero]
    )
) * 100


print(
    "\nOverall Results"
)

print(
    "-------------------------"
)

print(
    "MAE :",
    overall_mae
)

print(
    "RMSE:",
    overall_rmse
)

print(
    "MAPE:",
    overall_mape
)


# ============================================================
# 23. SAVE RESULTS TO EXCEL
# ============================================================

output_file = (
    "LSTM_SHAP_8week_WalkForward.xlsx"
)


with pd.ExcelWriter(
    output_file
) as writer:

    results.to_excel(
        writer,
        sheet_name="Forecasts",
        index=False
    )

    metrics_df.to_excel(
        writer,
        sheet_name="Horizon_Metrics",
        index=False
    )

    shap_importance.to_excel(
        writer,
        sheet_name="Final_SHAP",
        index=False
    )


print(
    "\nResults saved to:",
    output_file
)
